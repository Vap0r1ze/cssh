# Values listed here are used as defaults

# Required HTTP(S) or WS(S) URL for code-server
CSSH_URL=wss://your-code-server.example
# Working directory on the remote server
CSSH_CWD=/
# Optional code-server connection token
CSSH_CONNECTION_TOKEN=
# Cookie header value
CSSH_COOKIE=
# Verify TLS certificates; `true` by default
CSSH_REJECT_UNAUTHORIZED=true
# Positive handshake timeout in milliseconds
CSSH_HANDSHAKE_TIMEOUT_MS=10000
# Positive maximum message size
CSSH_MAX_MESSAGE_BYTES=67108864
# JSON object of additional HTTP header names and string values
CSSH_HEADERS={}
